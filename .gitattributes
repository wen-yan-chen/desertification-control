# Consistent text on all team computers.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.bib text eol=lf
# Preserve source-document bytes and manifest SHA256 values.
*.pdf binary
*.docx binary
*.caj binary
*.png binary
*.html -text
*.tex text eol=lf
# Preserve historical/raw bytes, including original whitespace, for SHA256.
archive/invalidated_20261109/** -text -whitespace
Data/raw/*.csv -text -whitespace
Data/raw/nasa_power_verified/*.json -text -whitespace
Data/raw/local_project_evidence/*.html -text -whitespace
